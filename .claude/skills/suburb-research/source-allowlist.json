  "banned": {
    "patterns": [
      "Any agent-sponsored \"suburb guide\" or \"investor report\" PDF, regardless of publisher",
      "SEO blog farms and microblog content (e.g. homely.com.au editorial sections, openagent.com.au editorial, ratemyagent.com.au editorial)",
      "Buyer's-agent or development-marketer content (conflict of interest — they're selling a thesis, not reporting on one)",
      "Forum posts, Reddit threads, Facebook groups, LinkedIn posts",
      "Wikipedia (use the underlying source it cites instead)",
      "AI-generated content farms",
      "Realtor/agent personal blogs"
    ],
    "rationale": "Banned sources either have a commercial interest in a specific narrative, lack editorial accountability, or are too transient to cite. A report that cites banned sources will fail server-side validation at upload-research."
  },
  "fallback_policy": {
    "in_allowlist_miss": "If Source-Finder finds a relevant URL that is NOT in the allow-list, do not fetch it. Append to log.md as a `## [YYYY-MM-DD] allowlist_miss | <publisher> | <url> | <reason it was relevant>` entry for human review. If multiple suburbs surface the same missing publisher, that's a signal to add it to the allow-list.",
    "in_tier1_gap": "If a pillar genuinely cannot be supported by any Tier-1 source (e.g. an obscure regional employment figure), the Copywriter must mark that pillar with a partial data flag and a clearly-stated gap rather than reach into Tier 2 for primary data."
  }
